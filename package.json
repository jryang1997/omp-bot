{
  "name": "omp-bot",
  "version": "0.1.0",
  "description": "基于 omp 的常驻 AI Bot 团队，提供 Windows 桌面应用、网页界面和 CLI。",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "ompbot": "./ompbot.mjs"
  },
  "scripts": {
    "demo": "node ompbot.mjs demo",
    "test": "node test/unit.mjs && node test/shutdown.mjs && node test/ledger.mjs && node test/runs.mjs && node test/features.mjs && node test/http-boundaries.mjs && node test/rpc-client.mjs && node test/channels.mjs && node smoke-gui.mjs && node gate.mjs && node smoke-b2b.mjs && node smoke-group.mjs && node smoke-persist.mjs",
    "serve": "node ompbot.mjs serve",
    "desktop": "electron .",
    "package:win": "node scripts/prepare-desktop.mjs && electron-builder --win --x64 --publish never",
    "test:unit": "node test/unit.mjs",
    "test:shutdown": "node test/shutdown.mjs",
    "test:ledger": "node test/ledger.mjs",
    "test:runs": "node test/runs.mjs",
    "test:features": "node test/features.mjs",
    "test:http": "node test/http-boundaries.mjs",
    "test:rpc": "node test/rpc-client.mjs",
    "test:channels": "node test/channels.mjs",
    "gate": "node gate.mjs",
    "smoke:gui": "node smoke-gui.mjs",
    "smoke:b2b": "node smoke-b2b.mjs",
    "smoke:group": "node smoke-group.mjs",
    "smoke:persist": "node smoke-persist.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "bot",
    "multi-agent",
    "group-chat",
    "rpc"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
