# Debian 的 /usr/bin/chromium 启动前会 source /etc/chromium.d 下的每个文件，以启动浏览器的用户身份运行。
# 由 omp-bot 每次开机后比对补装，改这里要连同 src/computer-seats.mjs 的 GUEST_FILES 一起看。
# 所有 profile 用同一种 cookie 加密方式（basic），共享库里的行才能直接并进来。
# 每个 bot 的磁盘缓存最多 256 MiB。
CHROMIUM_FLAGS="$CHROMIUM_FLAGS --password-store=basic --disk-cache-size=268435456"
export CHROMIUM_FLAGS
# 登录屏自己就是共享登录的来源，不用并。别的座席把共享 cookie 并进自己的 profile，失败也不挡浏览器启动。
if [ "$(id -un)" != omp-login ]; then
  /usr/bin/python3 /usr/local/lib/omp-bot/omp-login-sync sync >/dev/null 2>&1 || true
fi
